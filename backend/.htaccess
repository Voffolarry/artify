Options -Indexes

# ---- Encodage ----
AddDefaultCharset UTF-8

# ---- CORS & Headers ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Réécriture URL pour l'API ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /artify/

    # Laisser passer les fichiers et dossiers existants
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Routes API : /api/oeuvres/ ou /api/favoris → api/.../index.php
    RewriteRule ^api/([a-z_]+)/?$  api/$1/index.php  [L,QSA]
    RewriteRule ^api/([a-z_]+)/index\.php$  api/$1/index.php  [L,QSA]
</IfModule>
