# Artify — Variables d'environnement
# Copier ce fichier vers .env et renseigner vos valeurs :
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# MongoDB (Atlas ou local)
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/?appName=Artify
MONGO_DB=artify

# Clé secrète (sessions PHP) — générer une chaîne aléatoire longue
SECRET_KEY=remplacer_par_une_cle_secrete_aleatoire

# Préfixe URL des images statiques (XAMPP)
MEDIA_BASE_URL=/artify/images
